{
  "manifest_version": 3,
  "name": "STEYDA Candy Order Helper",
  "version": "0.3.0",
  "description": "Adds the STEYDA candy shopping list to ERT / Privab carts. Add-to-cart only — you review and check out. (Dagab stays manual.)",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": [
    "https://www.ertgodis.se/*",
    "https://ertgodis.se/*",
    "https://webbshop.ertgodis.se/*",
    "https://www.dagab.se/*",
    "https://dagab.se/*",
    "https://privab.se/*",
    "https://www.privab.se/*"
  ],
  "background": { "service_worker": "background.js" },
  "externally_connectable": {
    "matches": ["https://operations-steyda.github.io/*"]
  },
  "action": { "default_title": "STEYDA Candy Order Helper" }
}
